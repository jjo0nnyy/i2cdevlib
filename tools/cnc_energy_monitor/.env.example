# Copia este archivo a ".env" (en la misma carpeta que el script) y
# reemplaza los valores por los reales. NUNCA subas el archivo ".env" a git
# (ya está listado en .gitignore).
#
# Requiere: pip install python-dotenv

TELEGRAM_TOKEN=
TELEGRAM_CHAT_ID=
INFLUX_TOKEN=
GRAFANA_TOKEN=
MYSQL_PASSWORD=

